[
  {
    "id": "create-kakkoischool-repo",
    "prompt": "Create a public repo called my-first-game in KakkoiSchool from my current folder and push it.",
    "recipe": "recipes/kakkoischool-repository.md",
    "must": [
      "gh repo create KakkoiSchool/my-first-game",
      "--source=.",
      "--remote=origin",
      "--push",
      "gh repo view KakkoiSchool/my-first-game"
    ],
    "must_not": [
      "git@github.com:KakkoiSchool/my-first-game.git &&",
      "firebase",
      "vercel",
      "create it under your personal account"
    ]
  },
  {
    "id": "rename-repo",
    "prompt": "Rename KakkoiSchool/old-game to new-game and make sure my local clone still points to the right place.",
    "recipe": "recipes/rename-repository.md",
    "must": [
      "gh repo rename",
      "KakkoiSchool/old-game",
      "new-game",
      "git remote set-url origin",
      "gh repo view KakkoiSchool/new-game"
    ],
    "must_not": [
      "create a new repository",
      "copy all files",
      "delete KakkoiSchool/old-game"
    ]
  },
  {
    "id": "delete-repo",
    "prompt": "Delete KakkoiSchool/test-junk.",
    "recipe": "recipes/delete-repository.md",
    "must": [
      "gh repo view KakkoiSchool/test-junk",
      "delete_repo",
      "gh repo delete KakkoiSchool/test-junk"
    ],
    "must_not": [
      "gh repo delete KakkoiSchool/test-junk --yes",
      "rm -rf",
      "delete another repository"
    ]
  },
  {
    "id": "publish-pages",
    "prompt": "My repo KakkoiSchool/hello-site has index.html on main. Publish it as a GitHub Pages website.",
    "recipe": "recipes/github-pages.md",
    "must": [
      "repos/KakkoiSchool/hello-site/pages",
      "source[branch]=main",
      "source[path]=/",
      "html_url"
    ],
    "must_not": [
      "npm install",
      "react",
      "vercel",
      "netlify"
    ]
  },
  {
    "id": "multiplayer",
    "prompt": "Add multiplayer to my plain JavaScript browser game.",
    "recipe": "recipes/multiplayer.md",
    "must": [
      "KakkoiDev/p2p-core",
      "v0.1.0",
      "joinRoom",
      "room.send",
      "room.onMessage",
      "room.status()"
    ],
    "must_not": [
      "new RTCPeerConnection",
      "PeerJS",
      "Socket.IO",
      "Firebase",
      "hand-written relay"
    ]
  },
  {
    "id": "install-gh",
    "prompt": "I'm on a Mac and don't have the GitHub CLI. Help me install it and log in safely.",
    "recipe": "recipes/github-cli.md",
    "must": [
      "brew install gh",
      "gh --version",
      "gh auth login --web",
      "gh auth setup-git",
      "gh auth status"
    ],
    "must_not": [
      "paste your token",
      "gh auth token",
      "password in chat"
    ]
  },
  {
    "id": "browser-fallback",
    "prompt": "The AI cannot call the GitHub API and gh isn't available, but I need help getting to the Pages settings.",
    "recipe": "recipes/browser-fallback.md",
    "must": [
      "Playwright",
      "open-settings.mjs",
      "pages",
      "manually",
      "2FA"
    ],
    "must_not": [
      "automate your password",
      "bypass",
      "click the delete"
    ]
  },
  {
    "id": "blank-computer-setup",
    "prompt": "I only have a browser on my Mac. Help me set up everything I need for Kakkoi School so I can edit a website locally with AI and publish it to GitHub Pages.",
    "recipe": "setup/README.md",
    "must": [
      "GitHub account",
      "git --version",
      "gh auth login --web",
      "VS Code",
      "/serve",
      "localhost",
      "GitHub Pages"
    ],
    "must_not": [
      "paste your token",
      "buy GitHub Pro",
      "localhost is public",
      "upload your password",
      "code --install-extension ritwickdey.LiveServer"
    ]
  },
  {
    "id": "publish-static-default",
    "prompt": "I have a new plain HTML site with index.html on main and no hosting set up. Use /publish for this project.",
    "recipe": "skills/publish/SKILL.md",
    "must": [
      "GitHub Pages",
      "index.html",
      "main",
      "verify"
    ],
    "must_not": [
      "wrangler deploy",
      "npm install vite"
    ]
  },
  {
    "id": "publish-existing-worker",
    "prompt": "My project is already a Cloudflare Worker. It has a wrangler.toml and deploys from CI. Use /publish to release my API change.",
    "recipe": "recipes/cloudflare.md",
    "must": [
      "wrangler.toml",
      "Cloudflare Worker",
      "CI",
      "endpoint"
    ],
    "must_not": [
      "gh api --method POST repos/",
      "source[branch]=main",
      "wrangler deploy --env production"
    ]
  },
  {
    "id": "domain-existing-pages",
    "prompt": "My site is already on GitHub Pages. Connect www.example.com using the DNS zone I have in Cloudflare.",
    "recipe": "recipes/cloudflare.md",
    "must": [
      "GitHub Pages",
      "CNAME",
      "DNS-only",
      "github.io",
      "HTTPS"
    ],
    "must_not": [
      "wrangler deploy",
      "workers.dev",
      "change your nameservers"
    ]
  },
  {
    "id": "email-personal-digest",
    "prompt": "I want to preview my mainichi-news digest and test email locally before sending it to my own inbox.",
    "recipe": "recipes/email.md",
    "must": [
      "mainichi-news preview",
      "Mailpit",
      "127.0.0.1",
      "inbox"
    ],
    "must_not": [
      "paste your SMTP password",
      "spf.sendinblue.com"
    ]
  },
  {
    "id": "ai-recover-tool-action",
    "prompt": "I am building a Node agent that can update a project record. The model sometimes times out after asking the agent to update the record. How do I recover without repeating the update?",
    "recipe": "recipes/ai-features.md",
    "must": [
      "AI Core",
      "receipt",
      "timeout",
      "operation ID"
    ],
    "must_not": [
      "retry every tool call",
      "exactly-once guarantee"
    ]
  },
  {
    "id": "ai-guild-explore",
    "prompt": "/ai-guild I want to build something about Shimane news but haven't decided what.",
    "recipe": "skills/ai-guild/SKILL.md",
    "must": [
      "headlines",
      "email"
    ],
    "must_not": [
      "wrangler deploy",
      "SMTP_HOST",
      "I created"
    ]
  },
  {
    "id": "ai-guild-clear-task",
    "prompt": "Help me in AI Guild mode. My project is ./my-site. Please start it locally so I can see it.",
    "recipe": "skills/serve/SKILL.md",
    "must": [
      "/serve",
      "local"
    ],
    "must_not": [
      "What do you want to build",
      "wrangler deploy",
      "npm install vite"
    ]
  }
]
